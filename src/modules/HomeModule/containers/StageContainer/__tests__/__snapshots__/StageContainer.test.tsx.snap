exports[`StageContainer > matches snapshot (paused) 1`] = `
.c0 {
  position: relative;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  overflow: hidden;
  background: #111827;
  aspect-ratio: 16/9;
}

.c1 {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.c2 {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  padding: 16px;
}

.c3 {
  margin: 0;
  color: #e5e7eb;
  font-size: 24px;
  font-weight: 600;
  text-align: center;
}

<div
  class="c0"
>
  <div
    aria-busy="false"
    class="c1"
  >
    <div
      aria-live="polite"
      class="c2"
      role="status"
    >
      <p
        class="c3"
      >
        Упражнение приостановлено
      </p>
    </div>
  </div>
</div>
`;
